TELEGRAM_BOT_TOKEN=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=

# Обычно переопределяется в docker-compose, но можно задать и тут:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/diplomat
REDIS_URL=redis://localhost:6379/0

OPENAI_MODEL=gpt-4.1-mini
PERPLEXITY_ENDPOINT=https://api.perplexity.ai/chat/completions
PERPLEXITY_MODEL=sonar-pro
PERPLEXITY_USE_RESPONSE_FORMAT=true

FREE_DAILY_LIMIT=3
DISABLE_RATE_LIMIT=false
SESSION_MAX_TURNS=3
SESSION_TTL_SECONDS=604800
PERPLEXITY_CACHE_TTL_SECONDS=1800
PERPLEXITY_TIMEOUT_SECONDS=30
OPENAI_TIMEOUT_SECONDS=60

RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_SECONDS=0.7
RETRY_MAX_DELAY_SECONDS=8

LOG_LEVEL=INFO

WEBAPP_URL=


