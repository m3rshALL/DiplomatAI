# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=

# Mini App URL (must be HTTPS for production)
WEBAPP_URL=https://tokyo-run-elements-had.trycloudflare.com

# API Keys
PERPLEXITY_API_KEY=
OPENAI_API_KEY=

# Database (change password for production!)
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_THIS_PASSWORD@postgres:5432/diplomat
REDIS_URL=redis://redis:6379/0

# OpenAI Model (use gpt-4o or gpt-4-turbo for production)
OPENAI_MODEL=gpt-4o

# Perplexity Configuration
PERPLEXITY_ENDPOINT=https://api.perplexity.ai/chat/completions
PERPLEXITY_MODEL=sonar-pro
PERPLEXITY_USE_RESPONSE_FORMAT=true

# Rate Limiting
FREE_DAILY_LIMIT=10
DISABLE_RATE_LIMIT=false

# Timeouts (in seconds)
PERPLEXITY_TIMEOUT_SECONDS=60.0
OPENAI_TIMEOUT_SECONDS=120.0

# Retry Configuration
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=16.0

# Session Configuration
SESSION_MAX_TURNS=5
SESSION_TTL_SECONDS=604800
PERPLEXITY_CACHE_TTL_SECONDS=3600
